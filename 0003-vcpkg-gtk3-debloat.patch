++# Exclude .ui files for widgets not used by BleachBit and for platform-
++# inappropriate dialogs (Unix print dialogs, macOS quartz application).
++# The corresponding C source is either not compiled on Windows (printunix,
++# quartz) or never instantiated by BleachBit (emoji, font/color/app chooser,
++# assistant, recent chooser, volume button, search bar, lock button, action
++# bar).  Removing the template resources saves .rdata in the shared library.
++excluded_ui = {
++    'gtkactionbar.ui',
++    'gtkappchooserdialog.ui',
++    'gtkappchooserwidget.ui',
++    'gtkapplication-quartz.ui',
++    'gtkassistant.ui',
++    'gtkcolorchooserdialog.ui',
++    'gtkcoloreditor.ui',
++    'gtkemojichooser.ui',
++    'gtkemojicompletion.ui',
++    'gtkfontbutton.ui',
++    'gtkfontchooserdialog.ui',
++    'gtkfontchooserwidget.ui',
++    'gtklockbutton.ui',
++    'gtkpagesetupunixdialog.ui',
++    'gtkprintunixdialog.ui',
++    'gtkrecentchooserdefault.ui',
++    'gtksearchbar.ui',
++    'gtkvolumebutton.ui',
++}
++
+ for f in get_files('ui', '.ui'):
++  if f in excluded_ui:
++    continue
+   xml += '    <file preprocess=\'xml-stripblanks\'>ui/{0}</file>\n'.format(f)
+ 
+ xml += '\n'
+@@ -71,12 +87,7 @@ for s in ['16x16', '22x22', '24x24', '32x32', '48x48']:
