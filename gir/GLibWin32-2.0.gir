<?xml version="1.0"?>
<!-- Hand-written GIR for the GLibWin32 namespace.
  Generated to match glib 2.88.0 glib/gwin32.h API.
  The shared-library attribute uses the vcpkg/MSVC DLL naming convention
  (glib-2.0-0.dll, gobject-2.0-0.dll) rather than the MinGW convention
  (libglib-2.0-0.dll). -->
<repository version="1.2"
            xmlns="http://www.gtk.org/introspection/core/1.0"
            xmlns:c="http://www.gtk.org/introspection/c/1.0"
            xmlns:doc="http://www.gtk.org/introspection/doc/1.0"
            xmlns:glib="http://www.gtk.org/introspection/glib/1.0">
  <include name="GLib" version="2.0"/>
  <package name="glib-2.0"/>
  <c:include name="glib.h"/>
  <namespace name="GLibWin32" version="2.0"
             shared-library="glib-2.0-0.dll,gobject-2.0-0.dll"
             c:identifier-prefixes="GWin32,G"
             c:symbol-prefixes="glib,g_win32,g">
    <function-macro name="HAVE_WIDECHAR_API" c:identifier="G_WIN32_HAVE_WIDECHAR_API" introspectable="0"/>
    <function-macro name="IS_NT_BASED" c:identifier="G_WIN32_IS_NT_BASED" introspectable="0"/>
    <enumeration name="OSType" c:type="GWin32OSType">
      <doc xml:space="preserve">Type of Windows edition to check for at run-time.</doc>
      <member name="any" value="0" c:identifier="G_WIN32_OS_ANY">
        <doc xml:space="preserve">The running system can be a workstation or a server edition of
Windows.  The type of the running system is therefore not checked.</doc>
      </member>
      <member name="workstation" value="1" c:identifier="G_WIN32_OS_WORKSTATION">
        <doc xml:space="preserve">The running system is a workstation edition of Windows,
such as Windows 7 Professional.</doc>
      </member>
      <member name="server" value="2" c:identifier="G_WIN32_OS_SERVER">
        <doc xml:space="preserve">The running system is a server edition of Windows, such as
Windows Server 2008 R2.</doc>
      </member>
    </enumeration>
    <function name="check_windows_version" c:identifier="g_win32_check_windows_version" version="2.44">
      <doc xml:space="preserve">Returns a boolean indicating whether the version of Windows
running is at least the specified major, minor and service pack
version.</doc>
      <return-value transfer-ownership="none">
        <type name="gboolean" c:type="gboolean"/>
      </return-value>
      <parameters>
        <parameter name="major" transfer-ownership="none">
          <doc xml:space="preserve">major version of Windows</doc>
          <type name="gint" c:type="const gint"/>
        </parameter>
        <parameter name="minor" transfer-ownership="none">
          <doc xml:space="preserve">minor version of Windows</doc>
          <type name="gint" c:type="const gint"/>
        </parameter>
        <parameter name="spver" transfer-ownership="none">
          <doc xml:space="preserve">service pack version of Windows, or 0</doc>
          <type name="gint" c:type="const gint"/>
        </parameter>
        <parameter name="os_type" transfer-ownership="none">
          <doc xml:space="preserve">whether to check for workstation or server version</doc>
          <type name="OSType" c:type="const GWin32OSType"/>
        </parameter>
      </parameters>
    </function>
    <function name="error_message" c:identifier="g_win32_error_message">
      <doc xml:space="preserve">Translate a Win32 error code (as returned by GetLastError()) into
the corresponding message. The returned string should be deallocated
with g_free().</doc>
      <return-value transfer-ownership="full">
        <doc xml:space="preserve">the error message</doc>
        <type name="utf8" c:type="gchar*"/>
      </return-value>
      <parameters>
        <parameter name="error" transfer-ownership="none">
          <doc xml:space="preserve">Win32 error code</doc>
          <type name="gint" c:type="gint"/>
        </parameter>
      </parameters>
    </function>
    <function name="ftruncate" c:identifier="g_win32_ftruncate">
      <doc xml:space="preserve">Wraps the POSIX ftruncate() function in a way that's compatible
with Win32.  Emulates ftruncate() on Windows.</doc>
      <return-value transfer-ownership="none">
        <type name="gint" c:type="gint"/>
      </return-value>
      <parameters>
        <parameter name="f" transfer-ownership="none">
          <type name="gint" c:type="gint"/>
        </parameter>
        <parameter name="size" transfer-ownership="none">
          <type name="guint" c:type="guint"/>
        </parameter>
      </parameters>
    </function>
    <function name="get_command_line" c:identifier="g_win32_get_command_line" version="2.40" introspectable="0">
      <doc xml:space="preserve">Returns a string vector of the command line arguments, in UTF-8.</doc>
      <return-value>
        <array c:type="gchar**">
          <type name="utf8"/>
        </array>
      </return-value>
    </function>
    <function name="get_package_installation_directory" c:identifier="g_win32_get_package_installation_directory" deprecated="1" deprecated-version="2.36">
      <doc xml:space="preserve">Returns the installation directory for @package, or NULL.</doc>
      <return-value transfer-ownership="full" nullable="1">
        <type name="utf8" c:type="gchar*"/>
      </return-value>
      <parameters>
        <parameter name="package" transfer-ownership="none" nullable="1" allow-none="1">
          <type name="utf8" c:type="const gchar*"/>
        </parameter>
        <parameter name="dll_name" transfer-ownership="none" nullable="1" allow-none="1">
          <type name="utf8" c:type="const gchar*"/>
        </parameter>
      </parameters>
    </function>
    <function name="get_package_installation_directory_of_module" c:identifier="g_win32_get_package_installation_directory_of_module">
      <doc xml:space="preserve">Returns the installation directory for @hmodule.</doc>
      <return-value transfer-ownership="full">
        <type name="utf8" c:type="gchar*"/>
      </return-value>
      <parameters>
        <parameter name="hmodule" transfer-ownership="none" nullable="1" allow-none="1">
          <type name="gpointer" c:type="gpointer"/>
        </parameter>
      </parameters>
    </function>
    <function name="get_package_installation_subdirectory" c:identifier="g_win32_get_package_installation_subdirectory" deprecated="1" deprecated-version="2.36">
      <doc xml:space="preserve">Returns a newly-allocated string containing the path of the
subdirectory @subdir under the installation directory for @package.</doc>
      <return-value transfer-ownership="full">
        <type name="utf8" c:type="gchar*"/>
      </return-value>
      <parameters>
        <parameter name="package" transfer-ownership="none" nullable="1" allow-none="1">
          <type name="utf8" c:type="const gchar*"/>
        </parameter>
        <parameter name="dll_name" transfer-ownership="none" nullable="1" allow-none="1">
          <type name="utf8" c:type="const gchar*"/>
        </parameter>
        <parameter name="subdir" transfer-ownership="none">
          <type name="utf8" c:type="const gchar*"/>
        </parameter>
      </parameters>
    </function>
    <function name="get_windows_version" c:identifier="g_win32_get_windows_version" deprecated="1" deprecated-version="2.44">
      <doc xml:space="preserve">Returns version information for the Windows operating system.</doc>
      <return-value transfer-ownership="none">
        <type name="guint" c:type="guint"/>
      </return-value>
    </function>
    <function name="getlocale" c:identifier="g_win32_getlocale">
      <doc xml:space="preserve">Returns a string of the form "en", "zh_TW" etc.</doc>
      <return-value transfer-ownership="full">
        <type name="utf8" c:type="gchar*"/>
      </return-value>
    </function>
    <function name="locale_filename_from_utf8" c:identifier="g_win32_locale_filename_from_utf8">
      <doc xml:space="preserve">Converts a filename from UTF-8 to the system codepage.</doc>
      <return-value transfer-ownership="full">
        <type name="utf8" c:type="gchar*"/>
      </return-value>
      <parameters>
        <parameter name="utf8filename" transfer-ownership="none">
          <type name="utf8" c:type="const gchar*"/>
        </parameter>
      </parameters>
    </function>
  </namespace>
</repository>
