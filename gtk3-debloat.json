  "stub_callers": [
    {
      "_comment": "Emoji chooser/completion has callers in gtkentry.c and gtktextview.c. Stub the caller functions to early-return, replace the completion call with NULL, remove includes. The emoji .c files are removed via remove_compilation_units.",
      "sources_to_remove": [],
      "stubs": [
        {
          "file": "gtk/gtkentry.c",
          "function": "gtk_entry_insert_emoji",
          "replacement": "{ return; }"
        },
        {
          "file": "gtk/gtktextview.c",
          "function": "gtk_text_view_insert_emoji",
          "replacement": "{ return; }"
        }
      ],
      "replace_calls": [
        {
          "file": "gtk/gtkentry.c",
          "old": "gtk_emoji_completion_new (entry)",
          "new": "NULL"
        }
      ],
      "remove_includes": [
        {
          "file": "gtk/gtkentry.c",
          "headers": ["gtkemojichooser.h", "gtkemojicompletion.h"]
        },
        {
          "file": "gtk/gtktextview.c",
          "headers": ["gtkemojichooser.h"]
        }
      ]
    },
    {
      "_comment": "Remove stale includes from files that reference removed widgets but don't actually use their symbols.",
      "sources_to_remove": [],
      "remove_includes": [
        {
          "file": "gtk/gtkcontainer.c",
          "headers": ["gtkassistant.h"]
        }
      ],
      "replace_calls": [
        {
          "file": "gtk/gtkcontainer.c",
          "old": "#define SPECIAL_CONTAINER(x) (GTK_IS_ASSISTANT (x) || \\\n                              GTK_IS_ACTION_BAR (x) || \\\n                              GTK_IS_POPOVER_MENU (x) || \\\n                              GTK_IS_SHORTCUTS_SECTION (x) || \\\n                              GTK_IS_SHORTCUTS_WINDOW (x))",
          "new": "#define SPECIAL_CONTAINER(x) (GTK_IS_POPOVER_MENU (x) || \\\n                              GTK_IS_SHORTCUTS_SECTION (x) || \\\n                              GTK_IS_SHORTCUTS_WINDOW (x))"
        }
      ]
    },
    {
      "_comment": "Inspector sources are removed from the build (remove_inspector_sources). gtk_window_set_debugging is stubbed via stub_inspector_debugging, but update_debugging() still calls gtk_inspector_window_rescan. Also, gtkoffscreenwindow.h is removed from gtk.h so GTK_IS_OFFSCREEN_WINDOW macro is undefined; remove the check in gtk_window_notify_startup.",
      "sources_to_remove": [],
      "stubs": [
        {
          "file": "gtk/gtkwindow.c",
          "function": "update_debugging",
          "replacement": "{ gtk_window_update_debugging_id = 0; return G_SOURCE_REMOVE; }"
        }
      ],
      "replace_calls": [
        {
          "file": "gtk/gtkwindow.c",
          "old": "  if (!disable_startup_notification &&\n      !GTK_IS_OFFSCREEN_WINDOW (window) &&\n      priv->type != GTK_WINDOW_POPUP)",
          "new": "  if (!disable_startup_notification &&\n      priv->type != GTK_WINDOW_POPUP)"
        }
      ]
    }
  ],

  "gresource": {
    "_comment": "Remove resources from the embedded gresource bundle.",
    "exclude_ui": [
      "gtkapplication-quartz.ui",
      "gtkappchooserdialog.ui",
      "gtkappchooserwidget.ui",
      "gtkassistant.ui",
      "gtkcolorchooserdialog.ui",
      "gtkcoloreditor.ui",
      "gtkemojichooser.ui",
      "gtkemojicompletion.ui",
      "gtkfontbutton.ui",
      "gtkfontchooserdialog.ui",
      "gtkfontchooserwidget.ui",
      "gtklockbutton.ui",
      "gtkpagesetupunixdialog.ui",
      "gtkprintunixdialog.ui",
      "gtkrecentchooserdefault.ui",
      "gtksearchbar.ui",
      "gtkvolumebutton.ui",
      "gtkactionbar.ui",
      "gtkscalebutton.ui"
    ],
    "remove_themes": ["HighContrast"],
    "remove_inspector": true,
    "remove_emoji_data": true
  },

  "stub_inspector_debugging": true,

  "remove_inspector_sources": true,

  "meson_options": {
    "_comment": "Added to vcpkg portfile.cmake meson configure step.",
    "b_lto": true,
    "print_backends": ""
  }
}
